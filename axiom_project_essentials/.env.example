# Axiom local development environment template.
# Replace values only after verifying the actual application configuration.
# Never put private keys, database passwords, or server secrets in frontend variables.

# Example for Vite only if the app uses Vite:
# VITE_API_BASE_URL=http://localhost:8000

# Backend-only example, if applicable. Rename to match the actual backend settings:
# API_HOST=127.0.0.1
# API_PORT=8000
# DATABASE_URL=
# SECRET_KEY=
#
# Do not set or rely on these examples until the actual code supports them.
