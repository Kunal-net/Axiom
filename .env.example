# ==============================================================================
# Axiom — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - NEVER commit '.env' or any secret credentials to version control.
# - In Vite, only variables prefixed with 'VITE_' are bundled and visible to
#   the browser client. Never put private secrets, database connection strings,
#   or private AI API keys into 'VITE_' variables!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite — Exposed to Browser Client)
# ------------------------------------------------------------------------------

# Application environment: 'development' | 'staging' | 'production' | 'test'
VITE_APP_ENV=development

# Application UI title & branding
VITE_APP_TITLE=Axiom — Contract Intelligence for Independent Professionals

# Axiom Backend API Base URL
# When a real backend server is running (e.g. FastAPI / Express / Django on port 8000),
# set this to that service's origin.
VITE_API_BASE_URL=http://localhost:8000

# Mock Mode Toggle
# When 'true', Axiom uses its rich in-memory mock service and sample contracts
# (providing realistic 4-stage analysis simulation, diff comparison, and persistence).
# Set to 'false' to connect directly to the live backend specified by VITE_API_BASE_URL.
VITE_USE_MOCK_DATA=true


# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER CONFIGURATION (Server-Side ONLY — NEVER expose to browser)
# ------------------------------------------------------------------------------
# The variables below are reserved for the Axiom backend service when present.
# They are ignored by the Vite frontend build and MUST NEVER have a VITE_ prefix.

# Server binding host and port
API_HOST=127.0.0.1
API_PORT=8000

# Database connection URL (e.g. PostgreSQL, SQLite)
# Example: postgresql://axiom_user:local_dev_password@localhost:5432/axiom_db
DATABASE_URL=

# Cryptographic secret for signing sessions/JWTs
# Generate a secure key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-secure-secret-key-in-production

# AI Provider and API Key for server-side contract extraction & analysis
# Supported providers: 'gemini' | 'anthropic' | 'openai'
AI_PROVIDER=gemini
AI_API_KEY=your-server-side-api-key-here

# Allowed CORS origins for the backend API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
